        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(chat_realtime_delivery_latency_milliseconds_bucket[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
