<?xml version="1.0" encoding="UTF-8"?>
<!--
  콘솔은 Boot 기본 형식, 파일은 ECS JSON(구조화 로그)이다. 파일 이름에 호스트명을 넣어 여러 인스턴스가 같은 로그
  볼륨을 써도 섞이지 않게 한다. 하루 또는 최대 크기마다 새 파일로 넘기고 gzip으로 압축한다.
  감사 로그(audit 로거)는 따로 모아 더 오래 보관한다.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <springProperty name="LOG_DIR" source="chat.logging.dir" defaultValue="logs"/>
    <springProperty name="APP_MAX_FILE_SIZE" source="chat.logging.app.max-file-size" defaultValue="50MB"/>
    <springProperty name="APP_MAX_HISTORY" source="chat.logging.app.max-history" defaultValue="7"/>
    <springProperty name="APP_TOTAL_SIZE_CAP" source="chat.logging.app.total-size-cap" defaultValue="1GB"/>
    <springProperty name="AUDIT_MAX_FILE_SIZE" source="chat.logging.audit.max-file-size" defaultValue="50MB"/>
    <springProperty name="AUDIT_MAX_HISTORY" source="chat.logging.audit.max-history" defaultValue="30"/>
    <springProperty name="AUDIT_TOTAL_SIZE_CAP" source="chat.logging.audit.total-size-cap" defaultValue="500MB"/>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app-${HOSTNAME}.log</file>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app-${HOSTNAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${APP_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${APP_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${APP_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/audit-${HOSTNAME}.log</file>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/audit-${HOSTNAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${AUDIT_MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${AUDIT_MAX_HISTORY}</maxHistory>
            <totalSizeCap>${AUDIT_TOTAL_SIZE_CAP}</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 요청 스레드가 디스크 쓰기를 기다리지 않게 한다. 큐가 80% 넘게 차면 INFO 이하만 버리고 WARN 이상은 남긴다. -->
    <appender name="ASYNC_APP_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>20</discardingThreshold>
        <appender-ref ref="APP_FILE"/>
    </appender>

    <appender name="ASYNC_AUDIT_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>2048</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="AUDIT_FILE"/>
    </appender>

    <logger name="audit" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_AUDIT_FILE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_APP_FILE"/>
    </root>
</configuration>
